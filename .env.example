# PostgreSQL connection string
DATABASE_URL="postgresql://aiapp:aiapp_dev@localhost:5432/aiapp"

# Resend API key for sending emails (verification, password reset)
RESEND_API_KEY="re_your_api_key_here"

# Secret used to sign session cookies
SESSION_SECRET="your-session-secret-change-in-production"

# OpenAI API key (used by the chat assistant via Vercel AI SDK)
OPENAI_API_KEY="sk-your-openai-key-here"

# Anthropic API key (Claude models)
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key-here"

# Ollama base URL — defaults to http://localhost:11434/api
OLLAMA_BASE_URL="http://localhost:11434/api"

# File upload settings (defaults shown)
UPLOAD_DIR="./uploads"
MAX_FILES_PER_CONVERSATION="2"
MAX_FILE_SIZE_MB="5"

# Research mode: web search providers (Firecrawl is primary, Brave is fallback).
# At least one must be configured for the research pipeline to function.
FIRECRAWL_API_KEY=""
BRAVE_SEARCH_API_KEY=""
# Hard cap on web searches per research task (default 20)
MAX_SEARCHES_PER_RESEARCH="20"
# Hard cap on critique/revision iterations per research task (default 5)
MAX_RESEARCH_ITERATIONS="5"
# Hard cap on LLM calls per research task across drafting/critiquing/revising/
# fact-checking (default 10; excludes clarifying questions and file summarization)
MAX_LLM_CALLS_PER_RESEARCH="10"
# Hard cap on the number of claims the fact checker extracts and verifies per
# iteration (default 8). Each claim consumes one search from the shared search
# budget; remaining claims are marked "not_checked" when the budget runs out.
MAX_FACT_CHECK_CLAIMS_PER_ITERATION="8"

# Langfuse observability for the research pipeline. Both keys must be set to
# enable tracing; if either is missing, tracing silently no-ops. Each LLM call
# is emitted as a generation with token counts and an estimated USD cost,
# computed locally from a per-model pricing table in src/services/cost.ts —
# update that table when model prices change. LANGFUSE_BASE_URL defaults to
# https://cloud.langfuse.com.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
